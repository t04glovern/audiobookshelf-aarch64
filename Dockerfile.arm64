### STAGE 0: Build client ###
# Use Debian-based image for better ARM native module support
# (Alpine's musl libc lacks prebuilt @tailwindcss/oxide binaries for ARM)
FROM node:20-slim AS build-client

WORKDIR /client
COPY /client /client
RUN npm ci && npm cache clean --force
RUN npm run generate

### STAGE 1: Build server ###
FROM node:20-alpine AS build-server

ENV NODE_ENV=production

# Added py3-setuptools to fix "No module named 'distutils'" error on Python 3.12+
RUN apk add --no-cache --update \
  make \
  python3 \
  py3-setuptools \
  g++

WORKDIR /server
COPY index.js package* /server
COPY /server /server/server

RUN npm ci --omit=dev

### STAGE 2: Create minimal runtime image ###
FROM node:20-alpine

# Install only runtime dependencies
RUN apk add --no-cache --update \
  tzdata \
  ffmpeg \
  tini

WORKDIR /app

# Copy compiled frontend and server from build stages
COPY --from=build-client /client/dist /app/client/dist
COPY --from=build-server /server /app

EXPOSE 80

ENV PORT=80
ENV NODE_ENV=production
ENV CONFIG_PATH="/config"
ENV METADATA_PATH="/metadata"
ENV SOURCE="docker"
# Note: NUSQLITE3_PATH not set - unicode folding disabled but app works on 32-bit ARM

ENTRYPOINT ["tini", "--"]
CMD ["node", "index.js"]
